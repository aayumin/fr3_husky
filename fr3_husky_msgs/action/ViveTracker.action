# Define the goal
int8 control_mode 0                       # 0: CLIK, 1: OSF, 2:QPIK, 3:QPID (default: 0)
int8 teleop_mode 1                        # 0: Base, 1: Arm, 2: Wholebody, 3:Dual (default: 1)
string left_controller_ee_name            # EE name for tracking left vive controller
string right_controller_ee_name           # EE name for tracking right vive controller
bool move_orientation False               # move EE orientation or not (default: False)
float32 controller_pos_multiplier 1.0     # multiplier for target position from vive controller (default: 1.0)
float32 controller_ori_multiplier 1.0     # multiplier for target orientation from vive controller (default: 1.0)

---
# Define the result
bool is_completed
---
# Define a feedback message
bool is_qp_solved
string time_verbose