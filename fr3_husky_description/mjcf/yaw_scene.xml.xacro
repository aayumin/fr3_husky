<?xml version="1.0" encoding="utf-8"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">

    <xacro:macro name="square_scene">
        <!-- Visual walls from robosuite PegsArena -->
        <!-- <geom pos="-1.2 0 1.5" quat="0.5 0.5 0.5 0.5"
              size="1.5 1.5 0.01" type="box" conaffinity="0" contype="0"
              group="1" name="wall_rear_visual" material="walls_mat"/> -->

        <!-- Table geometry from robosuite TableArena with NutAssembly dimensions -->
        <body name="table" pos="0.7 -0.25 0.6">
            <geom name="table_collision"
                  pos="0 0 0"
                  size="0.4 0.6 0.025"
                  type="box"
                  group="0"
                  friction="1 0.005 0.0001"/>
            <geom name="table_visual"
                  pos="0 0 0"
                  size="0.4 0.6 0.025"
                  type="box"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_ceramic"/>
            <site name="table_top" pos="0 0 0.025" size="0.001 0.001 0.001" rgba="0 0 0 0"/>

            <geom name="table_leg1_visual"
                  pos="0.3 0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg2_visual"
                  pos="-0.3 0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg3_visual"
                  pos="-0.3 -0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg4_visual"
                  pos="0.3 -0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
        </body>

<!-- Movable T-shaped object -->
<body name="obj" pos="0.70 -0.50 0.84" quat="1 0 0 0">
    <joint name="obj_joint" type="free" damping="0.0005"/>

    <geom name="obj_t_stem"
          type="box"
          pos="0 -0.040 0"
          size="0.015 0.075 0.015"
          density="150"
          friction="1.0 0.3 0.1"
          condim="4"
          material="bmetal"/>

    <geom name="obj_t_head"
          type="box"
          pos="0 0.050 0"
          size="0.070 0.015 0.015"
          density="150"
          friction="1.0 0.3 0.1"
          condim="4"
          material="bmetal"/>

    <!-- <site name="obj_center_site" pos="0 0 0" size="0.004" rgba="1 0 0 1"/>
    <site name="obj_yaw_axis_site" pos="0 0.085 0" size="0.005" rgba="0 1 0 1"/> -->
</body>


<!-- Fixed T-shaped socket with small clearance -->
<body name="t_slot_fixture" pos="0.70 -0.25 0.65" quat="1 0 0 0">
    <geom name="t_slot_floor"
          type="box"
          pos="0 0 0"
          size="0.095 0.115 0.010"
          contype="1"
          conaffinity="1"
          material="ring_gray"/>

    <!-- outer walls forming a T-shaped cavity -->
    <geom name="t_slot_left_outer_wall"
          type="box"
          pos="-0.085 0.000 0.030"
          size="0.010 0.115 0.030"
          friction="1.0 0.3 0.1"
          material="env_blue"/>

    <geom name="t_slot_right_outer_wall"
          type="box"
          pos="0.085 0.000 0.030"
          size="0.010 0.115 0.030"
          friction="1.0 0.3 0.1"
          material="env_blue"/>

    <geom name="t_slot_top_wall"
          type="box"
          pos="0 0.105 0.030"
          size="0.085 0.010 0.030"
          friction="1.0 0.3 0.1"
          material="env_blue"/>

    <geom name="t_slot_bottom_wall"
          type="box"
          pos="0 -0.105 0.030"
          size="0.025 0.010 0.030"
          friction="1.0 0.3 0.1"
          material="env_blue"/>

    <!-- shoulders: these make the cavity a true T shape -->
    <geom name="t_slot_left_shoulder"
          type="box"
          pos="-0.055 -0.040 0.030"
          size="0.030 0.075 0.030"
          friction="1.0 0.3 0.1"
          material="env_blue"/>

    <geom name="t_slot_right_shoulder"
          type="box"
          pos="0.055 -0.040 0.030"
          size="0.030 0.075 0.030"
          friction="1.0 0.3 0.1"
          material="env_blue"/>

    <!-- <site name="t_slot_center_site" pos="0 0 0.045" size="0.005" rgba="1 0 0 1"/>
    <site name="t_slot_yaw_axis_site" pos="0 0.085 0.045" size="0.005" rgba="0 1 0 1"/> -->
</body>




    </xacro:macro>

</mujoco>
