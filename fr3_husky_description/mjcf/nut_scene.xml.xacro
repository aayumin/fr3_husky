<?xml version="1.0" encoding="utf-8"?>
<mujoco xmlns:xacro="http://www.ros.org/wiki/xacro">


    <!-- 1. 📂 STL 파일들을 MuJoCo 자산(Asset)으로 등록 -->
    <!-- 파일 경로는 본인의 fr3_husky_description 패키지 내 실제 폴더 구조에 맞게 대조하세요 -->
    <asset>
      <mesh name="bolt_mesh" file="$(find fr3_husky_description)/meshes/M12X35.stl_scaled.stl"/>
      <mesh name="nut_mesh" file="$(find fr3_husky_description)/meshes/M12_Nut_scaled.stl"/>
    </asset>

    <!-- 4. 나사산 연동 기어비 세팅 -->
    <tendon>
      <fixed name="screw_thread_coupling">
            <joint joint="nut_slide_z" coef="1.0"/>
            <joint joint="nut_hinge_z" coef="-0.000278"/> <!-- M12 표준 피치 비율 -->
      </fixed>
    </tendon>
      
    <xacro:macro name="nut_scene">
      

        <!-- Table geometry from robosuite TableArena with NutAssembly dimensions -->
        <body name="table" pos="0.9 -0.05 0.6">
            <geom name="table_collision"
                  pos="0 0 0"
                  size="0.35 0.5 0.025"
                  type="box"
                  group="0"
                  friction="1 0.005 0.0001"/>
            <geom name="table_visual"
                  pos="0 0 0"
                  size="0.35 0.5 0.025"
                  type="box"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_ceramic"/>
            <site name="table_top" pos="0 0 0.025" size="0.001 0.001 0.001" rgba="0 0 0 0"/>

            <geom name="table_leg1_visual"
                  pos="0.3 0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg2_visual"
                  pos="-0.3 0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg3_visual"
                  pos="-0.3 -0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
            <geom name="table_leg4_visual"
                  pos="0.3 -0.3 -0.3975"
                  size="0.025 0.3975"
                  type="cylinder"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="table_legs_metal"/>
        </body>


        <!-- 2. 🔩 STL 메쉬가 적용된 고정 볼트 (Peg) -->
        <body name="m12_bolt_peg" pos="0.8 -0.05 0.65">
            <site name="goal_success_site" rgba="1 0 0 1" size="0.005" pos="0 0 0.08"/>
            
            <!-- 물리적 충돌 영역(group 0)과 시각적 영역(group 1) 모두에 STL 메쉬 주입 -->
            <geom name="bolt_shaft_collision" 
                  type="mesh" 
                  mesh="bolt_mesh"
                  group="0"
                  friction="1 0.005 0.0001"/>
            <geom name="bolt_shaft_visual" 
                  type="mesh" 
                  mesh="bolt_mesh"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  material="matte_wood_dark"/>
        </body>

        <!-- 3. 🔩 볼트에 약간 끼워진 채 시작하는 STL 너트 -->
        <!-- Z축 높이(0.70)를 조절하여 초기 결합 깊이를 세팅하세요 -->
        <body name="m12_nut" pos="0.8 -0.05 0.70">
            <!-- 나사산 조인트 세팅 유지 -->
            <joint name="nut_slide_z" type="slide" axis="0 0 1" range="-0.05 0.08" limited="true" armature="0.001"/>
            <joint name="nut_hinge_z" type="hinge" axis="0 0 1" armature="0.001"/>

            <!-- 너트 메쉬 적용 -->
            <geom name="nut_collision"
                  type="mesh"
                  mesh="nut_mesh"
                  group="0"
                  rgba="0.7 0.7 0.3 1"
                  friction="1 0.005 0.0001"/>
            <geom name="nut_visual"
                  type="mesh"
                  mesh="nut_mesh"
                  conaffinity="0"
                  contype="0"
                  group="1"
                  rgba="0.8 0.8 0.2 1"/>
        </body>


    </xacro:macro>

</mujoco>
