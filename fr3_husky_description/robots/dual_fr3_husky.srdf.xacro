            <disable_collisions link1="right_fr3_link7" link2="right_fr3_hand_sc" reason="Default"/>
        
            <!-- base - left hand sc -->
            <disable_collisions link1="base_link" link2="left_fr3_hand_sc" reason="User"/>
            <disable_collisions link1="front_left_wheel${wheel_suffix}" link2="left_fr3_hand_sc" reason="User"/>
            <disable_collisions link1="front_right_wheel${wheel_suffix}" link2="left_fr3_hand_sc" reason="User"/>
            <disable_collisions link1="rear_left_wheel${wheel_suffix}" link2="left_fr3_hand_sc" reason="User"/>
