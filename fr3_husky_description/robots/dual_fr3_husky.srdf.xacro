    <!-- ============= if sc & if hand ============= -->
    <!-- =========================================== -->
    <!-- link list: left hand, left arm, right hand, right arm, base, left hand sc, left arm sc, right hand sc, right arm sc -->
     <xacro:if value="$(arg with_sc)">
        <xacro:if value="$(arg hand)">
            <!-- left hand - left hand -->
        
            <!-- left hand - left arm -->
            <disable_collisions link1="left_fr3_hand" link2="left_fr3_link0" reason="User"/>
