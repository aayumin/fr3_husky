<?xml version='1.0' encoding='utf-8'?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro" name="fr3">

    <xacro:include filename="$(find franka_description)/robots/common/franka_arm.srdf.xacro"/>
    <xacro:include filename="$(find fr3_husky_description)/robots/husky_base.srdf.xacro"/>

    <!-- ============================================================= -->

    <!-- Should an end-effector be mounted at the flange? -->
    <xacro:arg name="hand" default="true" />

    <!-- Should self-collision be enabled? -->
    <xacro:arg name="with_sc" default="true" />

    <!-- Assume Husky as two wheel mobile? (use only for pinocchio, not ros2_control) -->
    <xacro:arg name="as_two_wheels" default="false"/>
    <!-- ============================================================= -->

    <xacro:property name="as_two_wheels_val" value="$(arg as_two_wheels)"/>
    <xacro:property name="wheel_suffix"
                    value="${'_dummy' if str(as_two_wheels_val).lower() == 'true' else ''}"/>



    <!-- =========================================== -->
    <!-- ========= if not sc & if not hand ========= -->
    <!-- =========================================== -->
    <!-- link list: left arm,  right arm, base -->

    <!-- left arm - left arm -->
    <xacro:franka_arm_srdf arm_id="fr3"
                           hand="$(arg hand)"
                           ee_id="franka_hand"
                           no_prefix="false"
                           arm_prefix="left_">
    </xacro:franka_arm_srdf>

    <!-- left arm - right arm -->
    <disable_collisions link1="left_fr3_link0" link2="right_fr3_link0" reason="Adjacent"/>
    <disable_collisions link1="left_fr3_link0" link2="right_fr3_link1" reason="Never"/>
    <disable_collisions link1="left_fr3_link0" link2="right_fr3_link2" reason="Never"/>
    <disable_collisions link1="left_fr3_link0" link2="right_fr3_link3" reason="Never"/>

    <disable_collisions link1="left_fr3_link1" link2="right_fr3_link0" reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="right_fr3_link1" reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="right_fr3_link2" reason="Never"/>

    <disable_collisions link1="left_fr3_link2" link2="right_fr3_link0" reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="right_fr3_link1" reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="right_fr3_link2" reason="Never"/>

    <disable_collisions link1="left_fr3_link3" link2="right_fr3_link0" reason="Never"/>
     
    <!-- left arm - base -->
    <disable_collisions link1="left_fr3_link0" link2="base_link"                        reason="Adjacent"/>
    <disable_collisions link1="left_fr3_link0" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="left_fr3_link0" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link0" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="left_fr3_link0" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="left_fr3_link0" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link0" link2="top_structure_link"               reason="Default"/>

    <disable_collisions link1="left_fr3_link1" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link1" link2="top_structure_link"               reason="Never"/>

    <disable_collisions link1="left_fr3_link2" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link2" link2="top_structure_link"               reason="Never"/>

    <disable_collisions link1="left_fr3_link3" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="left_fr3_link3" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="left_fr3_link3" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link3" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="left_fr3_link3" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="left_fr3_link3" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link3" link2="top_structure_link"               reason="Never"/>

    <disable_collisions link1="left_fr3_link4" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="left_fr3_link4" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="left_fr3_link4" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="left_fr3_link4" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="left_fr3_link4" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="left_fr3_link4" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>

    <disable_collisions link1="left_fr3_link5" link2="base_link"                        reason="User"/>
    <disable_collisions link1="left_fr3_link5" link2="front_left_wheel${wheel_suffix}"  reason="User"/>
    <disable_collisions link1="left_fr3_link5" link2="front_right_wheel${wheel_suffix}" reason="User"/>
    <disable_collisions link1="left_fr3_link5" link2="rear_left_wheel${wheel_suffix}"   reason="User"/>
    <disable_collisions link1="left_fr3_link5" link2="rear_right_wheel${wheel_suffix}"  reason="User"/>

    <disable_collisions link1="left_fr3_link6" link2="base_link"                        reason="User"/>
    <disable_collisions link1="left_fr3_link6" link2="front_left_wheel${wheel_suffix}"  reason="User"/>
    <disable_collisions link1="left_fr3_link6" link2="front_right_wheel${wheel_suffix}" reason="User"/>
    <disable_collisions link1="left_fr3_link6" link2="rear_left_wheel${wheel_suffix}"   reason="User"/>
    <disable_collisions link1="left_fr3_link6" link2="rear_right_wheel${wheel_suffix}"  reason="User"/>

    <disable_collisions link1="left_fr3_link7" link2="base_link"                        reason="User"/>
    <disable_collisions link1="left_fr3_link7" link2="front_left_wheel${wheel_suffix}"  reason="User"/>
    <disable_collisions link1="left_fr3_link7" link2="front_right_wheel${wheel_suffix}" reason="User"/>
    <disable_collisions link1="left_fr3_link7" link2="rear_left_wheel${wheel_suffix}"   reason="User"/>
    <disable_collisions link1="left_fr3_link7" link2="rear_right_wheel${wheel_suffix}"  reason="User"/>

    <!-- right arm - right arm -->
    <xacro:franka_arm_srdf arm_id="fr3"
                           hand="$(arg hand)"
                           ee_id="franka_hand"
                           no_prefix="false"
                           arm_prefix="right_">
    </xacro:franka_arm_srdf>

    <!-- right arm - base -->
    <disable_collisions link1="right_fr3_link0" link2="base_link"                        reason="Adjacent"/>
    <disable_collisions link1="right_fr3_link0" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="right_fr3_link0" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link0" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="right_fr3_link0" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="right_fr3_link0" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link0" link2="top_structure_link"               reason="Default"/>

    <disable_collisions link1="right_fr3_link1" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="right_fr3_link1" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="right_fr3_link1" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link1" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="right_fr3_link1" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="right_fr3_link1" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link1" link2="top_structure_link"               reason="Never"/>

    <disable_collisions link1="right_fr3_link2" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="right_fr3_link2" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="right_fr3_link2" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link2" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="right_fr3_link2" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="right_fr3_link2" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link2" link2="top_structure_link"               reason="Never"/>

    <disable_collisions link1="right_fr3_link3" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="right_fr3_link3" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="right_fr3_link3" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link3" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="right_fr3_link3" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="right_fr3_link3" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link3" link2="top_structure_link"               reason="Never"/>

    <disable_collisions link1="right_fr3_link4" link2="base_link"                        reason="Never"/>
    <disable_collisions link1="right_fr3_link4" link2="base_wheel_collision_box_link"    reason="Never"/>
    <disable_collisions link1="right_fr3_link4" link2="front_left_wheel${wheel_suffix}"  reason="Never"/>
    <disable_collisions link1="right_fr3_link4" link2="front_right_wheel${wheel_suffix}" reason="Never"/>
    <disable_collisions link1="right_fr3_link4" link2="rear_left_wheel${wheel_suffix}"   reason="Never"/>
    <disable_collisions link1="right_fr3_link4" link2="rear_right_wheel${wheel_suffix}"  reason="Never"/>

    <disable_collisions link1="right_fr3_link5" link2="base_link"                        reason="User"/>
    <disable_collisions link1="right_fr3_link5" link2="front_left_wheel${wheel_suffix}"  reason="User"/>
    <disable_collisions link1="right_fr3_link5" link2="front_right_wheel${wheel_suffix}" reason="User"/>
    <disable_collisions link1="right_fr3_link5" link2="rear_left_wheel${wheel_suffix}"   reason="User"/>
    <disable_collisions link1="right_fr3_link5" link2="rear_right_wheel${wheel_suffix}"  reason="User"/>

    <disable_collisions link1="right_fr3_link6" link2="base_link"                        reason="User"/>
    <disable_collisions link1="right_fr3_link6" link2="front_left_wheel${wheel_suffix}"  reason="User"/>
    <disable_collisions link1="right_fr3_link6" link2="front_right_wheel${wheel_suffix}" reason="User"/>
    <disable_collisions link1="right_fr3_link6" link2="rear_left_wheel${wheel_suffix}"   reason="User"/>
    <disable_collisions link1="right_fr3_link6" link2="rear_right_wheel${wheel_suffix}"  reason="User"/>

    <disable_collisions link1="right_fr3_link7" link2="base_link"                        reason="User"/>
    <disable_collisions link1="right_fr3_link7" link2="front_left_wheel${wheel_suffix}"  reason="User"/>
    <disable_collisions link1="right_fr3_link7" link2="front_right_wheel${wheel_suffix}" reason="User"/>
    <disable_collisions link1="right_fr3_link7" link2="rear_left_wheel${wheel_suffix}"   reason="User"/>
    <disable_collisions link1="right_fr3_link7" link2="rear_right_wheel${wheel_suffix}"  reason="User"/>

    <!-- base - base -->
    <xacro:husky_base_srdf as_two_wheels="$(arg as_two_wheels)" />


    <!-- =========================================== -->
    <!-- =========== if not sc & if hand =========== -->
    <!-- =========================================== -->
    <!-- link list: left hand, left arm, right hand, right arm, base -->

    <xacro:if value="$(arg hand)">
        <!-- left hand - left hand -->
        <!-- already in franka_arm_srdf -->
        <disable_collisions link1="left_fr3_hand" link2="left_d435i_link" reason="Adjacent"/>
        <disable_collisions link1="left_fr3_leftfinger" link2="left_d435i_link" reason="Adjacent"/>
        <disable_collisions link1="left_fr3_rightfinger" link2="left_d435i_link" reason="Adjacent"/>

        <!-- left hand - left arm -->
        <disable_collisions link1="left_fr3_hand" link2="left_fr3_link5" reason="Never"/>

        <disable_collisions link1="left_d435i_link" link2="left_fr3_link3" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link4" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link5" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link6" reason="Never"/>
        <disable_collisions link1="left_d435i_link" link2="left_fr3_link7" reason="Never"/>

        <disable_collisions link1="left_fr3_leftfinger" link2="left_fr3_link5" reason="Never"/>
        <disable_collisions link1="left_fr3_rightfinger" link2="left_fr3_link5" reason="Never"/>

        <!-- left hand - right hand -->

        <!-- left hand - right arm -->

        <!-- left hand - base -->

        <!-- left arm - right hand -->

        <!-- right hand - right hand -->
        <!-- already in franka_arm_srdf -->
        <disable_collisions link1="right_fr3_hand" link2="right_d435i_link" reason="Adjacent"/>
        <disable_collisions link1="right_fr3_leftfinger" link2="right_d435i_link" reason="Adjacent"/>
        <disable_collisions link1="right_fr3_rightfinger" link2="right_d435i_link" reason="Adjacent"/>

        <!-- right hand - right arm -->
        <!-- already in franka_arm_srdf -->
        <disable_collisions link1="right_fr3_hand" link2="right_fr3_link5" reason="Never"/>

        <disable_collisions link1="right_d435i_link" link2="right_fr3_link3" reason="Never"/>
        <disable_collisions link1="right_d435i_link" link2="right_fr3_link4" reason="Never"/>
        <disable_collisions link1="right_d435i_link" link2="right_fr3_link5" reason="Never"/>
        <disable_collisions link1="right_d435i_link" link2="right_fr3_link6" reason="Never"/>
        <disable_collisions link1="right_d435i_link" link2="right_fr3_link7" reason="Never"/>

        <disable_collisions link1="right_fr3_leftfinger" link2="right_fr3_link5" reason="Never"/>
        <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link5" reason="Never"/>

        <!-- right hand - base -->
    </xacro:if>

    <!-- =========================================== -->
    <!-- =========== if sc & if not hand =========== -->
    <!-- =========================================== -->
    <!-- link list: left arm, right arm, base, left arm sc, right arm sc -->
    <xacro:if value="$(arg with_sc)">
        <!-- left arm - left arm -->
        <disable_collisions link1="left_fr3_link0" link2="left_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link0" link2="left_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link0" link2="left_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link1" link2="left_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link1" link2="left_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link1" link2="left_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link2" link2="left_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link2" link2="left_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link2" link2="left_fr3_link7" reason="User"/>

        <!-- left arm - right arm -->
        <disable_collisions link1="left_fr3_link0" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link0" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link0" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link0" link2="right_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link1" link2="right_fr3_link3" reason="User"/>
        <disable_collisions link1="left_fr3_link1" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link1" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link1" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link1" link2="right_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link2" link2="right_fr3_link3" reason="User"/>
        <disable_collisions link1="left_fr3_link2" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link2" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link2" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link2" link2="right_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link3" link2="right_fr3_link1" reason="User"/>
        <disable_collisions link1="left_fr3_link3" link2="right_fr3_link2" reason="User"/>
        <disable_collisions link1="left_fr3_link3" link2="right_fr3_link3" reason="User"/>
        <disable_collisions link1="left_fr3_link3" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link3" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link3" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link3" link2="right_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link0" reason="User"/>
        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link1" reason="User"/>
        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link2" reason="User"/>
        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link3" reason="User"/>
        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link4" link2="right_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link0" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link1" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link2" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link3" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="right_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link0" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link1" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link2" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link3" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="right_fr3_link7" reason="User"/>

        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link0" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link1" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link2" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link3" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link4" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link5" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link6" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="right_fr3_link7" reason="User"/>

        <!-- left arm - base -->
        <disable_collisions link1="left_fr3_link4" link2="top_structure_link" reason="User"/>

        <disable_collisions link1="left_fr3_link5" link2="base_wheel_collision_box_link" reason="User"/>
        <disable_collisions link1="left_fr3_link5" link2="top_structure_link"            reason="User"/>

        <disable_collisions link1="left_fr3_link6" link2="base_wheel_collision_box_link" reason="User"/>
        <disable_collisions link1="left_fr3_link6" link2="top_structure_link"            reason="User"/>

        <disable_collisions link1="left_fr3_link7" link2="base_wheel_collision_box_link" reason="User"/>
        <disable_collisions link1="left_fr3_link7" link2="top_structure_link"            reason="User"/>

        <!-- left arm - left arm sc -->
        <disable_collisions link1="left_fr3_link0" link2="left_fr3_link0_sc" reason="Adjacent"/>
        <disable_collisions link1="left_fr3_link0" link2="left_fr3_link1_sc" reason="Default"/>
        <disable_collisions link1="left_fr3_link0" link2="left_fr3_link2_sc" reason="Never"/>
        <disable_collisions link1="left_fr3_link0" link2="left_fr3_link3_sc" reason="Never"/>
