            <disable_collisions link1="right_fr3_rightfinger" link2="left_fr3_link7_sc" reason="User"/>
        
            <!-- right hand - right hand sc -->
            <disable_collisions link1="right_fr3_hand" link2="right_fr3_hand_sc" reason="Adjacent"/>

            <disable_collisions link1="right_fr3_leftfinger" link2="right_fr3_hand_sc" reason="Default"/>

            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_hand_sc" reason="Default"/>

            <disable_collisions link1="right_d435i_link" link2="right_fr3_hand_sc" reason="Default"/>
        
            <!-- right hand - right arm sc -->
            <disable_collisions link1="right_fr3_hand" link2="right_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="right_fr3_hand" link2="right_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="right_fr3_hand" link2="right_fr3_link2_sc" reason="User"/>
