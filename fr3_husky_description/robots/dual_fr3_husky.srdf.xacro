            <disable_collisions link1="right_fr3_hand" link2="right_fr3_link4_sc" reason="Never"/>
            <disable_collisions link1="right_fr3_hand" link2="right_fr3_link5_sc" reason="Never"/>
            <disable_collisions link1="right_fr3_hand" link2="right_fr3_link6_sc" reason="Never"/>
            <disable_collisions link1="right_fr3_hand" link2="right_fr3_link7_sc" reason="Default"/>

            <disable_collisions link1="right_fr3_leftfinger" link2="right_fr3_link0_sc" reason="User"/>
