            <disable_collisions link1="right_fr3_link7" link2="left_fr3_hand_sc" reason="User"/>
        
            <!-- right arm - right hand sc -->
            <disable_collisions link1="right_fr3_link0" link2="right_fr3_hand_sc" reason="User"/>
            <disable_collisions link1="right_fr3_link1" link2="right_fr3_hand_sc" reason="User"/>
