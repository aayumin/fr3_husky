            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link0_sc" reason="User"/>
            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link1_sc" reason="User"/>
            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link2_sc" reason="User"/>
            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link3_sc" reason="User"/>
            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link4_sc" reason="Never"/>
            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link5_sc" reason="Never"/>
            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link6_sc" reason="Never"/>
            <disable_collisions link1="right_fr3_rightfinger" link2="right_fr3_link7_sc" reason="Never"/>

            <disable_collisions link1="right_d435i_link" link2="right_fr3_link3_sc" reason="User"/>
